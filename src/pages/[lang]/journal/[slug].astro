---
import { articles, articleLangPaths, type Article, type Lang } from '../../../data/journal';
import StoryArticle from '../../../components/StoryArticle.astro';
import RajaArticle from '../../../components/RajaArticle.astro';
import WtrekArticle from '../../../components/WtrekArticle.astro';
import GuaviareArticle from '../../../components/GuaviareArticle.astro';

export function getStaticPaths() {
  const langs: Lang[] = ['en', 'it', 'es'];
  const paths = [];
  for (const a of articles) {
    for (const lang of langs) {
      paths.push({ params: { lang, slug: a.slugs[lang] }, props: { id: a.id, lang } });
    }
  }
  return paths;
}

const { id, lang } = Astro.props as { id: string; lang: Lang };
const article = articles.find((a) => a.id === id) as Article;
const langPaths = articleLangPaths(article);
---
{id === 'raja-ampat' && <RajaArticle lang={lang} langPaths={langPaths} />}
{id === 'w-trek' && <WtrekArticle lang={lang} langPaths={langPaths} />}
{id === 'guaviare' && <GuaviareArticle lang={lang} langPaths={langPaths} />}
{article.type === 'story' && <StoryArticle article={article} lang={lang} langPaths={langPaths} />}
