---
import Base from '../../layouts/Base.astro';
import i18nData from '../../data/i18n.json';
import aboutData from '../../data/about-html.json';

const i18n = i18nData as Record<string, Record<string, string>>;
const about = aboutData as Record<string, string>;

export function getStaticPaths() {
  return ['en', 'it', 'es'].map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const t = i18n[lang];
---
<Base
  lang={lang}
  page="about"
  title={`${t.nav_about} — Lorenzo Macovei`}
  description={t.about_intro_short ?? t.tagline}
>
  <div id="page-about" style="height:100vh;" set:html={about[lang]}></div>
</Base>

<style is:global>
  /* niente scroll-padding sul contenitore (sfasava lo snap della 2ª scena):
     la clearance dalla barra la do solo alla colonna di testo della bio,
     così la scena contatti resta perfettamente centrata a tutta altezza */
  #page-about .about-s1-text { padding-top: 90px; }

  /* CV — scena 3 (desktop) + blocco mobile */
  #page-about .about-s3 { height: auto; min-height: 100vh; scroll-snap-stop: normal; display: flex; align-items: center; }
  .about-cv { width: 100%; max-width: 1100px; margin: 0 auto; padding: 14vh 6vw; }
  #page-about .about-s3 .about-cv { opacity: 0; transform: translateY(20px); transition: opacity 1s ease, transform 1s cubic-bezier(.22,1,.36,1); }
  #page-about .about-s3 .about-cv.visible { opacity: 1; transform: none; }
  .cv-title { font-family: Arial, Helvetica, sans-serif; font-weight: 500; font-size: clamp(28px,4.5vw,50px); letter-spacing: -0.05em; line-height: .95; margin: 0; color: var(--text); }
  .cv-name { font-size: 13px; color: rgba(232,228,220,0.46); margin: 18px 0 6vh; letter-spacing: 0.02em; }
  .cv-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 4vw; }
  .cv-section { margin-bottom: 4vh; }
  .cv-section:last-child { margin-bottom: 0; }
  .cv-label { font-size: 10.5px; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(232,228,220,0.3); padding-bottom: 12px; border-bottom: 1px solid rgba(232,228,220,0.13); margin-bottom: 16px; }
  .cv-row { display: grid; grid-template-columns: 112px 1fr; gap: 18px; padding: 9px 0; align-items: baseline; }
  .cv-year { font-size: 12.5px; color: rgba(232,228,220,0.46); font-variant-numeric: tabular-nums; }
  .cv-entry { font-size: 14.5px; line-height: 1.5; color: var(--text); }
  .cv-entry .sub { display: block; color: rgba(232,228,220,0.46); font-size: 13px; margin-top: 2px; }
  .m-about-cv { margin-top: 1vh; }
  @media (max-width: 760px) {
    .about-cv { padding: 0; max-width: none; }
    .cv-cols { grid-template-columns: 1fr; gap: 0; }
    .cv-row { grid-template-columns: 70px 1fr; gap: 12px; }
    .cv-title { font-size: 30px; }
    .cv-name { margin-bottom: 4vh; }
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script is:inline>
  (function () {
    try { if (window.emailjs) emailjs.init('GSxU9XygDuEyTovjf'); } catch (e) {}

    // effetto slide come in home: ogni scena si rivela quando entra in vista
    function revealAll() {
      ['aboutIntro', 'aboutBio', 'aboutContact'].forEach(function (id) {
        var el = document.getElementById(id); if (el) el.classList.add('visible');
      });
      var im = document.getElementById('aboutImg'); if (im) im.classList.add('revealed');
    }
    var scroller = document.getElementById('page-about');
    if (scroller && 'IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.querySelectorAll('.about-s1-intro, .about-s1-bio, .about-s2-inner, .about-cv').forEach(function (el) { el.classList.add('visible'); });
          var im = e.target.querySelector('.about-s1-img'); if (im) im.classList.add('revealed');
        });
      }, { root: scroller, threshold: 0.35 });
      scroller.querySelectorAll('.about-scene').forEach(function (s) { obs.observe(s); });
    } else {
      revealAll();
    }

    function submit(ids, successId, e) {
      e.preventDefault();
      var btn = e.target.querySelector('button[type=submit]');
      var orig = btn.textContent;
      btn.textContent = 'Sending...';
      btn.disabled = true;
      if (!window.emailjs) { btn.textContent = orig; btn.disabled = false; alert('Email service not loaded — please email me directly.'); return; }
      emailjs.send('service_5o3o6vd', 'template_erjuszw', {
        from_name: document.getElementById(ids.name).value,
        from_email: document.getElementById(ids.email).value,
        inquiry: document.getElementById(ids.inquiry).value,
        message: document.getElementById(ids.message).value,
        email: document.getElementById(ids.email).value,
        name: document.getElementById(ids.name).value,
      }).then(function () {
        var s = document.getElementById(successId);
        if (s) s.style.display = 'block';
        btn.textContent = 'Message sent';
        e.target.reset();
      }).catch(function () {
        btn.textContent = orig;
        btn.disabled = false;
        alert('Something went wrong — please try again or email me directly.');
      });
    }
    window.submitContactForm = function (e) {
      submit({ name: 'cf-name', email: 'cf-email', inquiry: 'cf-inquiry', message: 'cf-message' }, 'contactSuccess', e);
    };
    window.submitContactFormMobile = function (e) {
      submit({ name: 'mcf-name', email: 'mcf-email', inquiry: 'mcf-inquiry', message: 'mcf-message' }, 'mContactSuccess', e);
    };
  })();
</script>
