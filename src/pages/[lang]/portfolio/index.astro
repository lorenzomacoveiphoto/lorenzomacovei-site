---
import i18n from '../../../data/i18n.json';
import data from '../../../data/portfolio.json';

export function getStaticPaths() {
  return ['en', 'it', 'es'].map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (i18n as Record<string, Record<string, string>>)[lang] ?? {};

// Temi mostrati nella landing (selezione editoriale, non la galleria intera).
const themes = ['nature', 'people', 'places'];
// Alterna orizzontali e verticali (partendo da un orizzontale) così la masonry
// non mette mai due foto con la stessa proporzione sulla stessa riga.
type Item = typeof data.items[number];
const interleave = (arr: Item[]) => {
  const land = arr.filter((it) => it.h <= it.w);
  const port = arr.filter((it) => it.h > it.w);
  const out: Item[] = [];
  let li = 0, pi = 0;
  while (li < land.length || pi < port.length) {
    if (li < land.length) out.push(land[li++]);
    if (pi < port.length) out.push(port[pi++]);
  }
  return out;
};
const sel = themes.map((cat) => ({
  cat,
  label: t[`cat_${cat}`] ?? cat,
  items: interleave(data.items.filter((i) => i.category === cat)),
}));

const site = 'https://lorenzomacovei.com';
const locales = ['en', 'it', 'es'];
const canonical = `${site}/${lang}/portfolio/`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark" />
  <style is:inline>html,body{background:#0a0a0a}</style>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{t.nav_portfolio ?? 'Portfolio'} — Lorenzo Macovei</title>
  <meta name="description" content={`${t.nav_portfolio ?? 'Portfolio'} — Lorenzo Macovei, borderless photographer. Nature, people and places from the road.`} />
  <link rel="canonical" href={canonical} />
  {locales.map((l) => <link rel="alternate" hreflang={l} href={`${site}/${l}/portfolio/`} />)}
  <link rel="alternate" hreflang="x-default" href={`${site}/en/portfolio/`} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${t.nav_portfolio ?? 'Portfolio'} — Lorenzo Macovei`} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={sel[0]?.items[0]?.src} />
<style>
  :root{
    --bg:#0a0a0a;--bg2:#161616;--text:#e8e4dc;--muted:rgba(232,228,220,0.46);
    --faint:rgba(232,228,220,0.3);--line:rgba(232,228,220,0.13);--accent:rgba(232,228,220,0.5);
    --display:Arial,Helvetica,sans-serif;--body:Arial,Helvetica,sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;overflow-x:clip}
  body{background:var(--bg);color:var(--text);font-family:var(--body);-webkit-font-smoothing:antialiased;overflow-x:clip}
  img{display:block;max-width:100%}
  a{color:inherit;text-decoration:none}

  .hd{position:sticky;top:0;z-index:40;transition:transform .5s cubic-bezier(.22,1,.36,1)}
  .hd.up{transform:translateY(-100%)}
  .hd-main{display:flex;align-items:center;justify-content:space-between;padding:13px 4.5vw;
    background:rgba(10,10,10,0.92)}
  /* Nome = logotipo del sito; la tagline è larga quanto il logotipo (--brandw da JS) */
  .brand{display:flex;flex-direction:column;gap:5px}
  .lm{display:flex;align-items:center;gap:0.4em}
  .lm>span{display:block;width:auto;height:15px;background:currentColor;
    -webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:left center;mask-position:left center;-webkit-mask-size:contain;mask-size:contain}
  .lm .l{aspect-ratio:1473.39/278.55;-webkit-mask-image:url(/lorenzo.svg);mask-image:url(/lorenzo.svg)}
  .lm .m{aspect-ratio:1473.09/324.9;-webkit-mask-image:url(/macovei.svg);mask-image:url(/macovei.svg)}
  .brand small{font-family:var(--body);font-weight:600;font-size:9px;text-transform:uppercase;color:var(--muted);white-space:nowrap}
  .site-nav{display:flex;align-items:center;gap:28px}
  .site-nav a{font-family:var(--display);font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:var(--faint);transition:color .25s}
  .site-nav a:hover,.site-nav a.active{color:var(--text)}
  .langs{display:flex;gap:9px;margin-left:8px}
  .langs a{font-size:10px;letter-spacing:0.12em}
  .langs a.on{color:var(--text)}
  /* barra temi, separata dalla nav generale */
  .cat-bar{display:flex;justify-content:center;gap:30px;padding:11px 4.5vw;background:rgba(10,10,10,0.92);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  /* blur frosted solo da desktop: su mobile niente backdrop-filter, altrimenti
     il menu a tutto schermo (position:fixed) si ancorerebbe all'header */
  .langs-desk{display:none}
  @media(min-width:761px){
    .hd-main,.cat-bar{backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
    /* stesso meccanismo della homepage: space-between (logo sx · nav · lingue dx), padding 40px */
    .hd-main{display:flex;justify-content:space-between;align-items:center;padding:13px 40px}
    .langs-desk{display:flex}
    .langs-mob{display:none}
  }
  .cat-bar a{font-family:var(--display);font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:var(--faint);transition:color .25s}
  .cat-bar a:hover,.cat-bar a.active{color:var(--text)}
  .burger{display:none;flex-direction:column;gap:5px;width:26px;background:none;border:0;cursor:pointer;padding:6px 0;z-index:50}
  .burger span{display:block;height:1.5px;width:24px;background:var(--text);transition:transform .3s,opacity .3s}
  @media(max-width:760px){
    .burger{display:flex}
    .hd-main,.cat-bar{background:#0a0a0a}
    .site-nav{position:fixed;inset:0;z-index:45;flex-direction:column;align-items:center;justify-content:center;gap:28px;
      background:#0a0a0a;transform:translateX(100%);transition:transform .42s cubic-bezier(.22,1,.36,1);visibility:hidden}
    .hd.menu-open .site-nav{visibility:visible}
    .hd.menu-open .site-nav{transform:none}
    .hd.menu-open .burger span:first-child{transform:translateY(3.2px) rotate(45deg)}
    .hd.menu-open .burger span:last-child{transform:translateY(-3.2px) rotate(-45deg)}
    .site-nav a{font-size:17px;letter-spacing:0.18em}
    .langs{margin:12px 0 0}
    .cat-bar{gap:20px;padding:10px 4.5vw}
  }

  main{max-width:1640px;margin:0 auto;padding:0 4.5vw}
  .intro{padding:12vh 0 8vh;border-bottom:1px solid var(--line)}
  .intro .kicker{font-family:var(--display);font-size:11px;letter-spacing:0.32em;text-transform:uppercase;color:var(--accent);margin-bottom:16px}
  .intro h1{font-family:var(--display);font-weight:500;font-size:clamp(50px,9vw,122px);line-height:.88;letter-spacing:-0.075em}
  @media(max-width:700px){.intro{padding:9vh 0 6vh}}

  section{padding:9vh 0 3vh;scroll-margin-top:86px}
  .head{margin-bottom:38px}
  .head h2{font-family:var(--display);font-weight:500;font-size:clamp(38px,6vw,78px);line-height:.9;letter-spacing:-0.065em}

  .gallery{columns:3 280px;column-gap:26px}
  .gallery.masoned{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));columns:auto;gap:26px;align-items:start}
  .gcol{min-width:0;display:flex;flex-direction:column;gap:26px}
  .gcol>figure{margin:0!important}
  @media(max-width:1050px){.gallery.masoned{grid-template-columns:repeat(2,minmax(0,1fr))}}
  figure{break-inside:avoid;margin:0 0 26px;position:relative}
  /* dimensioni FISSE per orientamento: orizzontali 3:2, verticali 2:3 (ritaglio
     con object-fit:cover) → tutte le orizzontali uguali, tutte le verticali uguali. */
  .shot{display:block;width:100%;margin:0;padding:0;border:0;overflow:hidden;background:var(--bg2);aspect-ratio:3/2;cursor:pointer}
  figure.port .shot{aspect-ratio:2/3}
  figure.square .shot{aspect-ratio:1/1}
  .shot img,.shot video{width:100%;height:100%;display:block;object-fit:cover;filter:brightness(.92) saturate(.9);opacity:0;transition:transform .9s cubic-bezier(.2,.7,.2,1),filter .5s,opacity .9s ease}
  .shot img.loaded,.shot video.loaded{opacity:1}
  figure:hover .shot img,figure:hover .shot video{transform:scale(1.035);filter:brightness(.6) saturate(.72)}
  /* didascalia: compare in hover, centrata sopra la foto (stile Brittany) */
  figcaption{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:5px;padding:18px;text-align:center;pointer-events:none;opacity:0;transition:opacity .45s ease}
  figure:hover figcaption{opacity:1}
  figcaption .n{font-family:var(--body);color:#fff;font-size:clamp(15px,1.25vw,19px);letter-spacing:0;text-shadow:0 1px 16px rgba(0,0,0,.55)}
  figcaption .l{font-family:var(--body);color:rgba(255,255,255,0.72);font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;text-shadow:0 1px 12px rgba(0,0,0,.5)}
  figcaption .series-tag{margin-top:9px;padding:5px 12px;border:1px solid rgba(255,255,255,0.5);border-radius:40px;font-family:var(--body);color:#fff;font-size:9.5px;letter-spacing:0.18em;text-transform:uppercase;text-shadow:0 1px 10px rgba(0,0,0,.5)}
  .rule{height:1px;background:var(--line);margin-top:34px}
  @media(max-width:700px){
    /* foto a filo dei bordi: padding solo su testo, galleria piena */
    main{padding:0}
    .intro{padding-left:4.5vw;padding-right:4.5vw}
    .head{padding-left:4.5vw;padding-right:4.5vw}
    .rule{margin-left:4.5vw;margin-right:4.5vw}
    .gallery{columns:2 140px;column-gap:10px}figure{margin-bottom:10px}
    .gallery.masoned{gap:10px}.gcol{gap:10px}
    /* mobile: niente nomi sulle foto */
    figcaption{display:none}
  }

  .foot{border-top:1px solid var(--line);margin-top:9vh;padding:7vh 4.5vw;max-width:1640px;margin-left:auto;margin-right:auto;
    display:flex;justify-content:space-between;align-items:center;gap:20px}
  .foot-right{display:flex;align-items:center;gap:20px}
  .ic{display:flex;color:var(--faint);transition:color .25s}
  .ic:hover{color:var(--text)}
  .ic svg{width:18px;height:18px;display:block}
  .copy{font-family:var(--display);font-size:10px;letter-spacing:0.1em;color:var(--faint);white-space:nowrap}
  @media(max-width:700px){
    .foot{flex-direction:column;align-items:flex-start;gap:22px;padding:6vh 5vw}
    .foot-right{width:100%;flex-wrap:wrap;gap:18px}
    .copy{order:3;width:100%}
  }
  #totop{font-family:var(--display);font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:var(--faint);cursor:pointer;transition:color .25s;background:none;border:0}
  #totop:hover{color:var(--text)}

  /* Lightbox */
  .lb{position:fixed;inset:0;z-index:100;background:rgba(8,8,8,0.97);display:none;align-items:center;justify-content:center}
  .lb.open{display:flex}
  .lb-stage{display:flex;align-items:center;justify-content:center}
  .lb-stage img,.lb-stage video{max-width:92vw;max-height:86vh;width:auto;height:auto;object-fit:contain;display:block}
  .lb-cap{position:absolute;left:0;right:0;bottom:20px;text-align:center;font-family:var(--body);font-size:12px;color:var(--muted);letter-spacing:0.04em}
  .lb-cap .n{color:var(--text)}
  .lb-cap .l{margin-left:12px}
  .lb-x{position:absolute;top:18px;right:24px;background:none;border:0;color:var(--text);font-size:22px;line-height:1;cursor:pointer;opacity:.7;transition:opacity .2s}
  .lb-x:hover{opacity:1}
  .lb-nav{position:absolute;top:50%;transform:translateY(-50%);background:none;border:0;color:var(--text);font-size:42px;line-height:1;cursor:pointer;opacity:.5;transition:opacity .2s;padding:12px}
  .lb-nav:hover{opacity:1}
  .lb-prev{left:1.5vw}.lb-next{right:1.5vw}
  @media(max-width:700px){.lb-nav{font-size:30px;padding:8px}.lb-x{font-size:20px;top:14px;right:16px}}

  .rise{opacity:0;transform:translateY(22px);transition:opacity .9s ease,transform .9s cubic-bezier(.22,1,.36,1)}
  .rise.in{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){.rise{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}
</style>
</head>
<body>
<header class="hd" id="hd">
  <div class="hd-main">
    <a class="brand" href={`/${lang}/`}>
      <span class="lm"><span class="l"></span><span class="m"></span></span>
      <small>{t.tagline ?? 'Borderless Photographer'}</small>
    </a>
    <button class="burger" id="burger" aria-label="Menu"><span></span><span></span></button>
    <nav class="site-nav" id="siteNav">
      <a href={`/${lang}/`}>{t.nav_home ?? 'Home'}</a>
      <a class="active" href={`/${lang}/portfolio/`}>{t.nav_portfolio ?? 'Portfolio'}</a>
      <a href={`/${lang}/journal/stories`}>{t.nav_journal ?? 'Journal'}</a>
      <a href={`/${lang}/about`}>{t.nav_about ?? 'About'}</a>
      <span class="langs langs-mob">{locales.map((l) => <a class={l === lang ? 'on' : ''} href={`/${l}/portfolio/`}>{l.toUpperCase()}</a>)}</span>
    </nav>
    <span class="langs langs-desk">{locales.map((l) => <a class={l === lang ? 'on' : ''} href={`/${l}/portfolio/`}>{l.toUpperCase()}</a>)}</span>
  </div>
  <div class="cat-bar" id="catBar">
    {sel.map((s) => <a class="jump" href={`#${s.cat}`}>{s.label}</a>)}
  </div>
</header>

<main id="top">
  <div class="intro">
    <div class="kicker">Selected Work · 2026</div>
    <h1>{t.nav_portfolio ?? 'Portfolio'}</h1>
  </div>

  {sel.map((s, si) => (
    <section id={s.cat}>
      <div class="head rise"><h2>{s.label}</h2></div>
      <div class="gallery">
        {s.items.map((it) => (
          <figure class={`rise ${it.w === it.h ? 'square' : (it.w > it.h ? 'land' : 'port')}${it.series ? ' is-series' : ''}`} data-ar={it.w === it.h ? '1' : (it.w > it.h ? '0.667' : '1.5')} data-full={it.src} data-name={it.name} data-loc={it.location} data-vid={it.type === 'video' ? '1' : '0'} data-series={it.series}>
            <button class="shot" type="button" aria-label={it.name} style={`background-color:${it.color || '#141414'}`}>
              {it.type === 'video'
                ? <video class="ph" src={it.src} autoplay muted loop playsinline></video>
                : <img class="ph" loading="lazy" src={it.src} alt={it.name} />}
            </button>
            <figcaption><span class="n">{it.name}</span><span class="l">{it.location}</span>{it.series && <span class="series-tag">+ {t.view_series ?? 'Discover'}</span>}</figcaption>
          </figure>
        ))}
      </div>
      {si < sel.length - 1 && <div class="rule"></div>}
    </section>
  ))}
</main>

<footer class="foot">
  <span class="lm"><span class="l"></span><span class="m"></span></span>
  <div class="foot-right">
    <a class="ic" href="https://instagram.com/lorenzomacovei_" target="_blank" rel="noopener" aria-label="Instagram">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
    </a>
    <a class="ic" href="mailto:lorenzomacoveiphoto@gmail.com" aria-label="Mail">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg>
    </a>
    <span class="copy">© {year} Lorenzo Macovei</span>
    <button id="totop">↑ Top</button>
  </div>
</footer>

<div class="lb" id="lb" aria-hidden="true">
  <button class="lb-x" id="lbX" aria-label="Close">✕</button>
  <button class="lb-nav lb-prev" id="lbPrev" aria-label="Previous">‹</button>
  <button class="lb-nav lb-next" id="lbNext" aria-label="Next">›</button>
  <div class="lb-stage" id="lbStage">
    <img id="lbImg" alt="" />
    <video id="lbVid" playsinline loop muted autoplay style="display:none"></video>
  </div>
  <div class="lb-cap"><span class="n" id="lbName"></span><span class="l" id="lbLoc"></span></div>
</div>

<script is:inline>
  document.getElementById('totop').addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });

  // Header: si nasconde scorrendo in basso, riappare in alto; hamburger su mobile.
  (function () {
    var hd = document.getElementById('hd'), burger = document.getElementById('burger'), nav = document.getElementById('siteNav');
    var lastY = window.scrollY || 0, hidden = false, ticking = false, menuOpen = false;
    burger.addEventListener('click', function () { menuOpen = !menuOpen; hd.classList.toggle('menu-open', menuOpen); document.body.style.overflow = menuOpen ? 'hidden' : ''; });
    nav.addEventListener('click', function (e) { if (e.target.tagName === 'A') { menuOpen = false; hd.classList.remove('menu-open'); document.body.style.overflow = ''; } });

    // tagline larga quanto il logotipo (stessa lunghezza del nome)
    var lm = document.querySelector('.lm'), tag = document.querySelector('.brand small');
    function fitBrand() {
      if (!lm || !tag) return;
      tag.style.letterSpacing = '0px';
      var lw = lm.getBoundingClientRect().width, tw = tag.getBoundingClientRect().width, n = (tag.textContent || '').length;
      if (n > 1 && lw > tw) tag.style.letterSpacing = ((lw - tw) / (n - 1)) + 'px';
    }
    fitBrand();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitBrand);
    window.addEventListener('resize', fitBrand);
    function update() {
      var y = window.scrollY || 0; if (y < 0) y = 0;
      if (!menuOpen) {
        if (y <= 90) { if (hidden) { hd.classList.remove('up'); hidden = false; } }           // in cima: sempre visibile
        else if (y > lastY + 6) { if (!hidden) { hd.classList.add('up'); hidden = true; } }     // scorri giù: nascondi
        else if (y < lastY - 6) { if (hidden) { hd.classList.remove('up'); hidden = false; } }  // scorri su: mostra
      }
      lastY = y; ticking = false;
    }
    window.addEventListener('scroll', function () { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
  })();

  // Masonry "colonna più corta" (usa data-ar): orizzontali e verticali si incastrano.
  function colCount() { return window.innerWidth <= 1050 ? 2 : 3; }
  function masonry() {
    var n = colCount();
    [].forEach.call(document.querySelectorAll('.gallery'), function (gal) {
      var figs = gal._figs || (gal._figs = [].slice.call(gal.querySelectorAll('figure')));
      var cols = [], h = [];
      for (var i = 0; i < n; i++) { var c = document.createElement('div'); c.className = 'gcol'; cols.push(c); h.push(0); }
      figs.forEach(function (f) {
        var a = parseFloat(f.getAttribute('data-ar')) || 1.1;
        var mi = 0; for (var i = 1; i < n; i++) if (h[i] < h[mi]) mi = i;
        cols[mi].appendChild(f); h[mi] += a + 0.16;
      });
      gal.classList.add('masoned');
      gal.innerHTML = ''; cols.forEach(function (c) { gal.appendChild(c); });
    });
  }
  masonry();
  var _rt; window.addEventListener('resize', function () { clearTimeout(_rt); _rt = setTimeout(masonry, 160); });

  // Dissolvenza foto: la cornice colorata resta finché l'immagine non è pronta, poi la foto compare.
  [].forEach.call(document.querySelectorAll('.shot .ph'), function (el) {
    var done = function () { el.classList.add('loaded'); };
    if (el.tagName === 'IMG') {
      if (el.complete && el.naturalWidth > 0) done();
      else { el.addEventListener('load', done); el.addEventListener('error', done); }
    } else {
      if (el.readyState >= 2) done();
      else { el.addEventListener('loadeddata', done); el.addEventListener('error', done); }
    }
  });

  // nav attivo + reveal
  var secs = [].slice.call(document.querySelectorAll('section[id]'));
  var links = {}; [].forEach.call(document.querySelectorAll('.cat-bar a'), function (a) { links[a.getAttribute('href').slice(1)] = a; });
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { for (var k in links) links[k].classList.remove('active'); links[e.target.id] && links[e.target.id].classList.add('active'); } }); }, { rootMargin: '-45% 0px -50% 0px' });
    secs.forEach(function (s) { io.observe(s); });
    // reveal bidirezionale: fade-in quando entra in vista (sù o giù), reset quando è
    // completamente fuori (fuori schermo, invisibile) → scorrendo su si ri-anima uguale
    var rio = new IntersectionObserver(function (es) { es.forEach(function (e) { e.target.classList.toggle('in', e.isIntersecting); }); }, { rootMargin: '0px 0px -6% 0px', threshold: 0 });
    document.querySelectorAll('.rise').forEach(function (el) { rio.observe(el); });
  } else { document.querySelectorAll('.rise').forEach(function (e) { e.classList.add('in'); }); }

  // Lightbox: clic su una foto la apre a schermo (niente redirect alla vecchia galleria).
  (function () {
    var lb = document.getElementById('lb'), img = document.getElementById('lbImg'), vid = document.getElementById('lbVid'),
        nm = document.getElementById('lbName'), lc = document.getElementById('lbLoc');
    var figs = [], idx = 0;
    function collect() { figs = [].slice.call(document.querySelectorAll('figure[data-full]')).sort(function (a, b) { var ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect(); return (ra.top - rb.top) || (ra.left - rb.left); }); }
    function show(i) {
      if (!figs.length) collect(); if (!figs.length) return;
      idx = (i + figs.length) % figs.length;
      var f = figs[idx], full = f.getAttribute('data-full'), isVid = f.getAttribute('data-vid') === '1';
      if (isVid) { img.style.display = 'none'; vid.style.display = 'block'; vid.src = full; vid.muted = true; var p = vid.play(); if (p && p.catch) p.catch(function () {}); }
      else { vid.pause(); vid.removeAttribute('src'); vid.style.display = 'none'; img.style.display = 'block'; img.src = full; }
      nm.textContent = f.getAttribute('data-name') || ''; lc.textContent = f.getAttribute('data-loc') || '';
    }
    function open(f) { collect(); show(figs.indexOf(f)); lb.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function close() { lb.classList.remove('open'); document.body.style.overflow = ''; vid.pause(); }
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.shot');
      if (!btn) return;
      var f = btn.closest('figure'); if (!f) return;
      var ser = f.getAttribute('data-series');
      if (ser) { var lg = document.documentElement.lang || 'en'; window.location.href = '/' + lg + '/portfolio/series/' + ser + '/'; return; }
      open(f);
    });
    document.getElementById('lbX').addEventListener('click', close);
    document.getElementById('lbPrev').addEventListener('click', function (e) { e.stopPropagation(); show(idx - 1); });
    document.getElementById('lbNext').addEventListener('click', function (e) { e.stopPropagation(); show(idx + 1); });
    lb.addEventListener('click', function (e) { if (e.target === lb || e.target.id === 'lbStage') close(); });
    document.addEventListener('keydown', function (e) {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') close(); else if (e.key === 'ArrowRight') show(idx + 1); else if (e.key === 'ArrowLeft') show(idx - 1);
    });
  })();
</script>
</body>
</html>
