---
// /portfolio parte da "Nature". Il redirect vero è lato Netlify (istantaneo);
// questa pagina è solo un fallback, resa scura per non lampeggiare bianca.
export function getStaticPaths() {
  return ['en', 'it', 'es'].map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const target = `/${lang}/portfolio/nature`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://lorenzomacovei.com${target}`} />
    <title>Portfolio — Lorenzo Macovei</title>
    <style>html,body{background:#0a0a0a;margin:0}</style>
  </head>
  <body></body>
</html>
