\n\n      <!-- Scene 2: Categories -->\n      <div class=\"snap-scene\" id=\"scene2\">\n        <div class=\"s2-inner\" id=\"s2Inner\">\n          <div class=\"s2-cats\">\n            <span class=\"s2-cat-link\" onclick=\"showPage('portfolio');showCat('nature',document.querySelector('.mobile-cat-tab[onclick*=&quot;nature&quot;]'))\" data-i18n=\"cat_nature\">Naturaleza</span>\n            &#160;·&#160;\n            <span class=\"s2-cat-link\" onclick=\"showPage('portfolio');showCat('people',document.querySelector('.mobile-cat-tab[onclick*=&quot;people&quot;]'))\" data-i18n=\"cat_people\">Personas</span>\n            &#160;·&#160;\n            <span class=\"s2-cat-link\" onclick=\"showPage('portfolio');showCat('places',document.querySelector('.mobile-cat-tab[onclick*=&quot;places&quot;]'))\" data-i18n=\"cat_places\">Lugares</span>\n          </div>\n        </div>\n        <div class=\"s2-loc\" id=\"s2Loc\">Torres del Paine, Chile</div>\n      </div>\n\n      <!-- Scene Bio — desktop: single scene; mobile: split via CSS into 3 sub-scenes -->\n      <div class=\"snap-scene bio-scene\" id=\"sceneBio\">\n        <div class=\"bio-inner\" id=\"bioInner\">\n          <div class=\"bio-photo\">\n            <img loading=\"lazy\" src=\"https://res.cloudinary.com/dligvuje7/image/upload/v1780878455/BE98473E-9543-483E-ABF5-6E8DD9C4EA1D_ttmvum.jpg\" alt=\"Lorenzo Macovei\">\n          </div>\n          <div class=\"bio-text\">\n            <div class=\"bio-eyebrow\" data-i18n=\"bio_eyebrow\">Sin fronteras. Sin límites. Solo historias.</div>\n            <div class=\"bio-centerpiece\" data-i18n=\"tagline_break\">Fotógrafo<br>Sin Fronteras</div>\n            <div class=\"bio-headline\" data-i18n=\"bio_headline\">Viajero · Narrador · Activista climático</div>\n            <p class=\"bio-body\" data-i18n=\"bio_body\">Persiguiendo los cinco rincones del mundo — a tiempo completo, con una cámara en mano y una causa en mente. Viajo por las historias que no llegan al feed: las personas, los paisajes, los momentos silenciosos donde la naturaleza y la humanidad se encuentran. Disparo tanto en digital como en película.</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Mobile: bio + foto insieme in una scena -->\n      <div class=\"snap-scene mobile-bio-combined\" id=\"mobileBioCombined\" style=\"scroll-snap-align:start;\">\n        <div class=\"mobile-bio-combined-inner\">\n          <div class=\"mobile-bio-combined-photo\">\n            <img src=\"https://res.cloudinary.com/dligvuje7/image/upload/v1780878455/BE98473E-9543-483E-ABF5-6E8DD9C4EA1D_ttmvum.jpg\" alt=\"Lorenzo Macovei\">\n          </div>\n          <div class=\"mobile-bio-combined-text\">\n            <div class=\"bio-eyebrow\" style=\"margin-bottom:8px;\">No borders. No limits. Just stories.</div>\n            <div class=\"bio-centerpiece\" style=\"font-size:clamp(24px,6.5vw,36px);color:#fff;margin-bottom:8px;\">Borderless<br>Photographer</div>\n            <div class=\"bio-headline\" style=\"font-size:12px;color:rgba(255,255,255,0.6);margin-bottom:12px;\">Traveller · Storyteller · Climate activist</div>\n            <p style=\"font-family:var(--display);font-size:13px;font-weight:100;color:rgba(255,255,255,0.75);line-height:1.8;letter-spacing:0.02em;\">Chasing all five corners of the world — full-time, with a camera in hand and a cause in mind. I travel for the stories that don’t make it to the feed: the people, the landscapes, the quiet moments where nature and humanity meet. I shoot both digital and film.</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Scene Featured -->\n      <div class=\"snap-scene content-scene\">\n        <div class=\"section-label\"><span data-i18n=\"featured\">Destacados</span></div>\n        <div class=\"feat-slider-wrap\" id=\"featSliderWrap\">\n          <button class=\"feat-nav feat-nav-prev\" id=\"featPrev\" onclick=\"featSlide(-1)\"><span class=\"feat-nav-arrow\">←</span></button>\n          <button class=\"feat-nav feat-n