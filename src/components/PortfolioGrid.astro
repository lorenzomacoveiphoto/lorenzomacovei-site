---
interface Item { type: string; src: string; name: string; loc: string; category: string; location: string; w: number; h: number; color: string; }
const { items } = Astro.props as { items: Item[] };
---
<div class="portfolio-grid">
  {items.map((it) => (
    <div
      class="pg-item"
      data-src={it.src}
      data-name={it.name}
      data-loc={it.loc}
      data-type={it.type}
      style={`aspect-ratio:${it.w} / ${it.h}; background-color:${it.color};`}
    >
      {it.type === 'video' ? (
        <video class="pg-media" autoplay muted loop playsinline src={it.src}></video>
      ) : (
        <img class="pg-media" loading="lazy" src={it.src} alt={it.name} />
      )}
      <div class="pg-hover">
        <div class="pg-hover-cat">{it.loc}</div>
        <div class="pg-hover-name">{it.name}</div>
      </div>
    </div>
  ))}
</div>

<style is:global>
  /* cornici preimpostate a colore; la foto ci si carica dentro in dissolvenza */
  .portfolio-grid .pg-item {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
    position: relative;
    overflow: hidden;
  }
  .portfolio-grid .pg-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.9s ease;
    filter: brightness(0.9) saturate(0.85);
  }
  .portfolio-grid .pg-media.loaded { opacity: 1; }
  .portfolio-grid .pg-item:hover .pg-media {
    filter: brightness(0.62) saturate(0.68);
    transform: scale(1.03);
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.portfolio-grid img.pg-media').forEach(function (im) {
      if (im.complete && im.naturalWidth) im.classList.add('loaded');
      else im.addEventListener('load', function () { im.classList.add('loaded'); });
    });
    document.querySelectorAll('.portfolio-grid video.pg-media').forEach(function (v) { v.classList.add('loaded'); });
  })();
</script>
