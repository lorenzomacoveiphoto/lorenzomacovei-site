---
interface Item { type: string; src: string; name: string; loc: string; category: string; location: string; w: number; h: number; color: string; }
const { items } = Astro.props as { items: Item[] };
---
<div class="portfolio-grid">
  {items.map((it) => (
    <div
      class="pg-item"
      data-src={it.src}
      data-name={it.name}
      data-loc={it.loc}
      data-type={it.type}
      style={`aspect-ratio:${it.w} / ${it.h}; background-color:${it.color};`}
    >
      {it.type === 'video' ? (
        <video class="pg-media" autoplay muted loop playsinline src={it.src}></video>
      ) : (
        <img class="pg-media" loading="lazy" src={it.src} alt={it.name} />
      )}
      <div class="pg-hover">
        <div class="pg-hover-cat">{it.loc}</div>
        <div class="pg-hover-name">{it.name}</div>
      </div>
    </div>
  ))}
</div>

<style is:global>
  /* Cornici colorate: compaiono subito col layout. La foto ci si dissolve
     dentro con calma (dissolvenza lunga), una per una. */
  .portfolio-grid .pg-item {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
    position: relative;
    overflow: hidden;
  }
  /* La cornice intera entra da sotto (slide-up + fade). La foto ci si
     dissolve dentro come prima, indipendentemente da questo movimento. */
  .portfolio-grid .pg-item.pg-rise {
    opacity: 0 !important;
    transform: translateY(46px) !important;
    transition: opacity 0.8s cubic-bezier(0.22, 0.61, 0.36, 1),
                transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1) !important;
    will-change: opacity, transform;
  }
  .portfolio-grid .pg-item.pg-rise.pg-in {
    opacity: 1 !important;
    transform: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .portfolio-grid .pg-item.pg-rise {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
  .portfolio-grid .pg-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.22, 0.61, 0.36, 1);
    filter: brightness(0.9) saturate(0.85);
    will-change: opacity;
  }
  .portfolio-grid .pg-media.loaded { opacity: 1; }
  .portfolio-grid .pg-item:hover .pg-media {
    filter: brightness(0.62) saturate(0.68);
    transform: scale(1.03);
  }
  /* Se il browser non ha JS o preferisce meno movimento, la foto resta piena */
  @media (prefers-reduced-motion: reduce) {
    .portfolio-grid .pg-media { transition: opacity 0.3s ease; }
  }
</style>

<script is:inline>
  (function () {
    var grid = document.querySelector('.portfolio-grid');
    if (!grid) return;

    // ── Masonry a 2 colonne su mobile: ogni foto nella colonna più "corta"
    //    (stimata dalle proporzioni note) → alternanza coerente orizz/vert. ──
    function _isMobile() { return window.matchMedia('(max-width: 768px)').matches; }
    function _ratio(it) {
      var m = (it.getAttribute('style') || '').match(/aspect-ratio:\s*([\d.]+)\s*\/\s*([\d.]+)/);
      if (m) { var w = parseFloat(m[1]), h = parseFloat(m[2]); if (w > 0) return h / w; }
      return 1;
    }
    function _flatten() {
      var cols = grid.querySelectorAll('.pg-col');
      if (!cols.length) return;
      var frag = document.createDocumentFragment();
      [].forEach.call(grid.querySelectorAll('.pg-item'), function (it) { frag.appendChild(it); });
      [].forEach.call(cols, function (c) { c.remove(); });
      grid.appendChild(frag);
    }
    function _masonry() {
      _flatten();
      if (!_isMobile()) { grid.classList.remove('masonry-ready'); return; }
      var items = [].slice.call(grid.children).filter(function (n) { return n.classList && n.classList.contains('pg-item'); });
      var c1 = document.createElement('div'); c1.className = 'pg-col';
      var c2 = document.createElement('div'); c2.className = 'pg-col';
      var h1 = 0, h2 = 0;
      items.forEach(function (it) { var r = _ratio(it); if (h1 <= h2) { c1.appendChild(it); h1 += r; } else { c2.appendChild(it); h2 += r; } });
      grid.appendChild(c1); grid.appendChild(c2);
      grid.classList.add('masonry-ready');
    }
    _masonry();
    var _rt; window.addEventListener('resize', function () { clearTimeout(_rt); _rt = setTimeout(_masonry, 200); });

    var lastAt = 0, step = 0;
    // Rivela la foto con una piccola cascata (una per una) e SEMPRE in dissolvenza,
    // anche se è già in cache: un reflow sincrono (offsetWidth) fa "vedere" al
    // browser opacity:0 prima di passare a 1, così la transizione parte sempre.
    function reveal(im) {
      var now = (window.performance && performance.now) ? performance.now() : Date.now();
      if (now - lastAt > 260) step = 0;               // nuovo gruppo → riparte la cascata
      lastAt = now;
      im.style.transitionDelay = Math.min(step * 85, 510) + 'ms';
      step++;
      void im.offsetWidth;                            // forza il reflow: niente "scatto"
      im.classList.add('loaded');
    }
    [].forEach.call(grid.querySelectorAll('img.pg-media'), function (im) {
      if (im.complete && im.naturalWidth) reveal(im);
      else {
        im.addEventListener('load', function () { reveal(im); });
        im.addEventListener('error', function () { im.classList.add('loaded'); });
      }
    });
    [].forEach.call(grid.querySelectorAll('video.pg-media'), function (v) { v.classList.add('loaded'); });

    // La CORNICE entra da sotto (slide-up + fade). Indipendente dalla dissolvenza
    // della foto qui sopra: prima la cornice sale in posizione, poi la foto ci si
    // dissolve dentro come sempre. Sopra la piega: entra al load, a cascata.
    // Sotto la piega: entra quando scrolli fin lì (IntersectionObserver).
    var items = [].slice.call(grid.querySelectorAll('.pg-item'));
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach(function (it) { it.classList.add('pg-rise', 'pg-in'); });
    } else {
      items.forEach(function (it) { it.classList.add('pg-rise'); });
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('pg-in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.04 });
      var nAbove = 0;
      items.forEach(function (it) {
        if (it.getBoundingClientRect().top < vh) {   // già in vista: entra subito, a cascata
          it.style.transitionDelay = Math.min(nAbove * 70, 500) + 'ms';
          nAbove++;
        } else {                                     // sotto la piega: entra allo scroll
          io.observe(it);
        }
      });
      // doppio rAF: fa dipingere lo stato iniziale (.pg-rise) prima di rivelare,
      // così la transizione parte davvero anche per le cornici già in vista.
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          items.forEach(function (it) {
            if (it.getBoundingClientRect().top < vh) it.classList.add('pg-in');
          });
        });
      });
    }
  })();
</script>
