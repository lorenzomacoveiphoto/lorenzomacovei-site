<div class="lightbox" id="lightbox">
  <div class="lb-frame" id="lbFrame">
    <div class="lb-click-prev" onclick="lbNav(-1)"></div>
    <div class="lb-click-next" onclick="lbNav(1)"></div>
    <img id="lbImg" src="" alt="" />
    <video id="lbVideo" controls playsinline loop style="display:none;"></video>
    <div class="lb-caption">
      <span class="lb-caption-name" id="lbName"></span>
      <span class="lb-caption-loc" id="lbLoc"></span>
    </div>
  </div>
</div>

<style is:global>
  /* frame a colonna: foto sopra, didascalia sotto — entra sempre nello schermo */
  #lightbox .lb-frame {
    padding: 16px !important;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    max-width: 94vw !important;
  }
  #lightbox .lb-frame img,
  #lightbox .lb-frame video {
    display: block;
    width: auto !important; height: auto !important;
    max-width: 90vw !important; max-height: 80vh !important;
    object-fit: contain;
  }
  #lightbox .lb-caption {
    position: static !important; height: auto !important;
    left: auto !important; right: auto !important; bottom: auto !important;
    width: 100%;
    display: flex; align-items: baseline; justify-content: space-between; gap: 20px;
    background: transparent !important;
  }
  #lightbox .lb-click-prev, #lightbox .lb-click-next { bottom: 0 !important; }
</style>

<script is:inline>
  (function () {
    var lb = document.getElementById('lightbox');
    var img = document.getElementById('lbImg');
    var vid = document.getElementById('lbVideo');
    var name = document.getElementById('lbName');
    var loc = document.getElementById('lbLoc');
    if (!lb) return;
    var items = [];
    var idx = 0;
    function refresh() { items = [].slice.call(document.querySelectorAll('.portfolio-grid .pg-item')); }
    function show(i) {
      if (!items.length) return;
      idx = (i + items.length) % items.length;
      var el = items[idx];
      var src = el.getAttribute('data-src');
      var isVideo = el.getAttribute('data-type') === 'video';
      if (isVideo) {
        img.style.display = 'none';
        vid.style.display = 'block';
        vid.src = src;
        var p = vid.play(); if (p && p.catch) p.catch(function () {});
      } else {
        vid.pause();
        vid.style.display = 'none';
        img.style.display = 'block';
        img.src = src;
      }
      img.alt = el.getAttribute('data-name') || '';
      name.textContent = el.getAttribute('data-name') || '';
      loc.textContent = el.getAttribute('data-loc') || '';
    }
    window.lbNav = function (d) { show(idx + d); };
    window.openLightboxSingle = function (src, nm, lc) {
      items = [];
      vid.pause(); vid.style.display = 'none';
      img.style.display = 'block'; img.src = src; img.alt = nm || '';
      name.textContent = nm || ''; loc.textContent = lc || '';
      lb.classList.add('open'); document.body.style.overflow = 'hidden';
    };
    window.closeLightbox = function () {
      lb.classList.remove('open');
      document.body.style.overflow = '';
      vid.pause();
    };
    document.addEventListener('click', function (e) {
      var it = e.target.closest && e.target.closest('.portfolio-grid .pg-item');
      if (it) { refresh(); show(items.indexOf(it)); lb.classList.add('open'); document.body.style.overflow = 'hidden'; }
    });
    lb.addEventListener('click', function (e) { if (e.target === lb) window.closeLightbox(); });
    document.addEventListener('keydown', function (e) {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') window.closeLightbox();
      else if (e.key === 'ArrowRight') window.lbNav(1);
      else if (e.key === 'ArrowLeft') window.lbNav(-1);
    });
  })();
</script>
