<div class="lightbox" id="lightbox">
  <div class="lb-frame" id="lbFrame">
    <div class="lb-click-prev" onclick="lbNav(-1)"></div>
    <div class="lb-click-next" onclick="lbNav(1)"></div>
    <img id="lbImg" src="" alt="" />
    <video id="lbVideo" controls playsinline loop style="display:none; width:100%; height:auto; max-height:82vh;"></video>
    <div class="lb-caption">
      <div class="lb-caption-name" id="lbName"></div>
      <div class="lb-caption-loc" id="lbLoc"></div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var lb = document.getElementById('lightbox');
    var img = document.getElementById('lbImg');
    var vid = document.getElementById('lbVideo');
    var name = document.getElementById('lbName');
    var loc = document.getElementById('lbLoc');
    if (!lb) return;
    var items = [];
    var idx = 0;
    function refresh() { items = [].slice.call(document.querySelectorAll('.portfolio-grid .pg-item')); }
    function show(i) {
      if (!items.length) return;
      idx = (i + items.length) % items.length;
      var el = items[idx];
      var src = el.getAttribute('data-src');
      var isVideo = el.getAttribute('data-type') === 'video';
      if (isVideo) {
        img.style.display = 'none';
        vid.style.display = 'block';
        vid.src = src;
        var p = vid.play(); if (p && p.catch) p.catch(function () {});
      } else {
        vid.pause();
        vid.style.display = 'none';
        img.style.display = 'block';
        img.src = src;
      }
      img.alt = el.getAttribute('data-name') || '';
      name.textContent = el.getAttribute('data-name') || '';
      loc.textContent = el.getAttribute('data-loc') || '';
    }
    window.lbNav = function (d) { show(idx + d); };
    // apertura singola (foto "Featured" della home, senza prev/next)
    window.openLightboxSingle = function (src, nm, lc) {
      items = [];
      vid.pause();
      vid.style.display = 'none';
      img.style.display = 'block';
      img.src = src;
      img.alt = nm || '';
      name.textContent = nm || '';
      loc.textContent = lc || '';
      lb.classList.add('open');
      document.body.style.overflow = 'hidden';
    };
    window.closeLightbox = function () {
      lb.classList.remove('open');
      document.body.style.overflow = '';
      vid.pause();
    };
    document.addEventListener('click', function (e) {
      var it = e.target.closest && e.target.closest('.portfolio-grid .pg-item');
      if (it) { refresh(); show(items.indexOf(it)); lb.classList.add('open'); document.body.style.overflow = 'hidden'; }
    });
    lb.addEventListener('click', function (e) { if (e.target === lb) window.closeLightbox(); });
    document.addEventListener('keydown', function (e) {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') window.closeLightbox();
      else if (e.key === 'ArrowRight') window.lbNav(1);
      else if (e.key === 'ArrowLeft') window.lbNav(-1);
    });
  })();
</script>
